# Optional API fallback. ChatGPT/Codex sign-in does not need this key.
OPENAI_API_KEY=
WORDSCAPE_API_MODEL=gpt-6.1-sol
# Configurable geographic providers for your deployment.
WORDSCAPE_OVERPASS_URL=https://overpass.private.coffee/api/interpreter
WORDSCAPE_OSM_API_URL=https://api.openstreetmap.org/api/0.6/map
WORDSCAPE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Set to off to disable the bounded OSM map API fallback.
WORDSCAPE_OSM_FALLBACK=on
