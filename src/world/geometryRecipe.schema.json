{
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "version", "space", "evidence", "parts"],
  "properties": {
    "type": { "type": "string", "enum": ["parts"] },
    "version": { "type": "integer", "enum": [1] },
    "space": { "type": "string", "enum": ["normalized-object"] },
    "evidence": { "type": "string", "enum": ["authored"] },
    "parts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "primitive",
          "position",
          "rotation",
          "dimensions",
          "color",
          "footprint"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "label": { "type": "string", "minLength": 1, "maxLength": 120 },
          "primitive": {
            "type": "string",
            "enum": ["box", "cylinder", "cone", "sphere", "extruded-polygon"]
          },
          "position": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": { "type": "number", "minimum": -0.5, "maximum": 1 }
          },
          "rotation": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": { "type": "number", "minimum": -180, "maximum": 180 }
          },
          "dimensions": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": { "type": "number", "minimum": 0.001, "maximum": 1 }
          },
          "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "footprint": {
            "anyOf": [
              { "type": "null" },
              {
                "type": "array",
                "minItems": 3,
                "maxItems": 16,
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": { "type": "number", "minimum": -0.5, "maximum": 0.5 }
                }
              }
            ]
          }
        }
      }
    }
  }
}
