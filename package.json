{
  "name": "wordscape",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite --host 127.0.0.1",
    "companion": "node --env-file-if-exists=.env server/index.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:server": "vitest run server scripts/dev.test.mjs",
    "test:watch": "vitest",
    "lint": "eslint .",
    "check": "npm run lint && npm test && npm run build",
    "history": "node scripts/export-history.mjs",
    "history:final": "node scripts/finalize-history.mjs",
    "test:browser": "node scripts/smoke.mjs",
    "format": "prettier --write src scripts server *.json *.js *.ts .github README.md AGENTS.md",
    "format:check": "prettier --check src scripts server *.json *.js *.ts .github README.md AGENTS.md",
    "test:browser:studio": "node scripts/studio-smoke.mjs",
    "test:browser:surveys": "node scripts/survey-library-smoke.mjs",
    "test:browser:atlas": "node scripts/atlas-smoke.mjs",
    "test:browser:navigation": "node scripts/navigation-smoke.mjs",
    "test:browser:worlds": "node scripts/world-generation-smoke.mjs",
    "test:browser:framework": "node scripts/framework-smoke.mjs",
    "test:browser:washington": "node scripts/washington-enrichment-smoke.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.73.0",
    "pngjs": "^7.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
